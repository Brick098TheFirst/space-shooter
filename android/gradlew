#!/usr/bin/env sh

# Attempt to set APP_HOME
APP_HOME=$(cd "$(dirname "$0")" && pwd -P)
export APP_HOME

if [ -f "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" ]; then
    exec java -Dorg.gradle.appname="$0" -classpath "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
elif command -v gradle >/dev/null 2>&1; then
    exec gradle "$@"
else
    echo "ERROR: Neither gradle-wrapper.jar nor system gradle found in PATH."
    exit 1
fi
